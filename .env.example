ZENDESK_SUBDOMAIN=your-subdomain
# OAuth client_credentials creds -- Admin Center -> Apps and integrations -> APIs ->
# OAuth clients -> Add OAuth client (client kind: Confidential, no redirect URI needed)
ZENDESK_CLIENT_ID=your-oauth-client-id
ZENDESK_CLIENT_SECRET=your-oauth-client-secret
ZENDESK_WEBHOOK_SECRET=changeme
ZENDESK_RENEWAL_FIELD_ID=

# Filled in by `python -m scripts.setup_zendesk_fields`
ZENDESK_FRUSTRATION_FIELD_ID=
ZENDESK_CONFIDENCE_FIELD_ID=
ZENDESK_SUMMARY_FIELD_ID=
ZENDESK_ANALYZED_AT_FIELD_ID=

ANTHROPIC_API_KEY=changeme
LLM_MODEL=claude-sonnet-5

# Slack incoming webhook URLs (Slack app -> Incoming Webhooks -> Add New Webhook to Workspace).
# Leave any of these blank to skip that channel.
SLACK_WEBHOOK_CS=
SLACK_WEBHOOK_PRODUCT=
SLACK_WEBHOOK_ENGINEERING=
